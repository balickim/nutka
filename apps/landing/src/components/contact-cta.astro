---
import { site } from "../data/site";

const { contact, contactSection } = site;

const channels = [
  { icon: "phone", label: "Telefon", value: contact.phone, href: contact.phoneHref },
  { icon: "mail", label: "E-mail", value: contact.email, href: contact.emailHref },
  { icon: "whatsapp", label: "WhatsApp", value: "Napisz wiadomość", href: contact.whatsappHref },
] as const;
---

<section id="kontakt" class="container-x scroll-mt-24 pb-20">
  <div class="reveal rounded-block bg-ink px-6 py-14 text-center text-cream sm:px-12 sm:py-20">
    <p class="eyebrow text-cream/70">{contactSection.eyebrow}</p>
    <h2 class="mx-auto mt-4 max-w-2xl text-[clamp(2rem,4.5vw,3.4rem)]">{contactSection.title}</h2>
    <p class="mx-auto mt-5 max-w-xl leading-relaxed text-cream/80">{contactSection.lede}</p>

    <ul class="mx-auto mt-12 grid max-w-3xl gap-4 sm:grid-cols-3">
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              class="flex h-full flex-col items-center gap-3 rounded-card border border-cream/20 bg-cream/5 px-5 py-7 transition-colors hover:bg-cream/12"
            >
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-grass text-ink">
                {channel.icon === "phone" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.12 4.2 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z" />
                  </svg>
                )}
                {channel.icon === "mail" && (
                  <svg
                    width="20"
                    height="20"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                    <path d="m3 7 9 5.5L21 7" />
                  </svg>
                )}
                {channel.icon === "whatsapp" && (
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15s-.77.97-.94 1.16c-.17.2-.35.22-.64.08-.3-.15-1.26-.47-2.4-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.53.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.6-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.87 1.22 3.07c.15.2 2.1 3.2 5.08 4.49.7.3 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2-1.41.25-.7.25-1.29.18-1.42-.08-.12-.28-.2-.57-.34M12.05 21.8a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.89-9.89 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.89-9.89 9.89m8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.9c0 2.09.54 4.14 1.58 5.94L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45c6.55 0 11.89-5.34 11.89-11.9 0-3.18-1.24-6.17-3.49-8.4" />
                  </svg>
                )}
              </span>
              <span class="text-xs font-semibold tracking-widest text-cream/60 uppercase">{channel.label}</span>
              <span class="font-semibold break-words">{channel.value}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
