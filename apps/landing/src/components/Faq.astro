---
import { site } from "../data/site";

const { faq } = site;
---

<section id="faq" class="container-x section reveal">
  <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div>
      <p class="eyebrow">{faq.eyebrow}</p>
      <h2 class="mt-4 text-[clamp(1.9rem,4vw,3rem)]">{faq.title}</h2>
    </div>

    <!-- Natywne details/summary: rozwijanie działa bez JavaScriptu i z czytnikiem ekranu. -->
    <div class="divide-y divide-line border-y border-line">
      {
        faq.items.map((item) => (
          <details class="group py-5">
            <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-semibold">
              {item.question}
              <span
                class="mt-1 shrink-0 text-2xl leading-none text-muted transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <p class="mt-4 max-w-2xl leading-relaxed text-muted">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
