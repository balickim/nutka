---
import { site } from "../data/site";

const { howItWorks } = site;
---

<section id="jak-zaczac" class="bg-cream-deep/60">
  <div class="container-x section reveal">
    <p class="eyebrow">{howItWorks.eyebrow}</p>
    <h2 class="mt-4 max-w-3xl text-[clamp(2rem,4.5vw,3.4rem)]">{howItWorks.title}</h2>

    <ol class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        howItWorks.steps.map((step, index) => (
          <li class="relative rounded-card border border-line bg-cream p-7">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-grass font-display text-lg font-semibold text-ink">
              {index + 1}
            </span>
            <h3 class="mt-5 text-xl leading-snug">{step.name}</h3>
            <p class="mt-3 leading-relaxed text-muted">{step.description}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
