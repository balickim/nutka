---
/**
 * Tło ulotki: rysunki kreskowe instrumentów i nut.
 *
 * Wektor, nie zdjęcia — w projekcie nie ma jeszcze fotografii (config.photos to null),
 * a kreska w jednym kolorze drukuje się przewidywalnie i nie zamula pliku.
 *
 * viewBox odpowiada formatowi brutto 1:1 w milimetrach (152 × 214), więc współrzędne
 * w tym pliku to wprost milimetry na papierze. Grafiki celowo wychodzą poza krawędzie:
 * to elementy tła, a zakaz z instrukcji Drukomatu dotyczy tekstów i logo, nie tła.
 *
 * Grubości kresek są podane wewnątrz każdej grupy z uwzględnieniem jej skali, żeby
 * wszystko drukowało się mniej więcej tą samą kreską ok. 0,6 mm. Przy dziedziczeniu
 * grubości z korzenia skala zjadałaby ją proporcjonalnie i cieńsze elementy gubiłyby
 * się w druku.
 */

/* Gitara klasyczna, układ lokalny: próg zerowy w y = 0, siodełko mostka w y = SCALE_LENGTH.
   Wszystkie proporcje wyprowadzone z gitary 4/4: menzura 650 mm, pudło 490 mm. */
const SCALE_LENGTH = 178;
const BODY_JOINT = SCALE_LENGTH / 2; // Dwunasty próg wypada na styku gryfu z pudłem.

/* Progi rozstawia reguła 2^(-n/12): odległości maleją w miarę schodzenia do pudła.
   Równy rozstaw to najbardziej rzucający się w oczy błąd na rysunku gryfu. */
const frets = Array.from({ length: 10 }, (_, i) => SCALE_LENGTH * (1 - 2 ** (-(i + 1) / 12)));

/* Gryf się rozszerza: 52 mm przy siodełku, 62 mm przy dwunastym progu. */
const neckHalfWidth = (y: number) => 7.1 + (8.5 - 7.1) * (y / BODY_JOINT);

/* Struny rozchodzą się wachlarzowo — przy mostku są szerzej niż przy siodełku. */
const strings = Array.from({ length: 6 }, (_, i) => ({
  xNut: -5.4 + i * (10.8 / 5),
  xBridge: -7.9 + i * (15.8 / 5),
}));
---

<svg
  class="backdrop"
  viewBox="0 0 152 214"
  width="152mm"
  height="214mm"
  fill="none"
  stroke="currentColor"
  stroke-width="0.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  <!-- Klawiatura wchodząca zza prawej krawędzi, na wysokości nagłówka. -->
  <g transform="translate(108 -6) rotate(14) scale(0.62)" stroke-width="0.97">
    <rect x="0" y="0" width="140" height="46" rx="2.5" />
    {[17.5, 35, 52.5, 70, 87.5, 105, 122.5].map((x) => <line x1={x} y1="0" x2={x} y2="46" />)}
    {
      [12, 30, 65, 83, 101].map((x) => (
        <rect x={x} y="0" width="11" height="27" rx="1.5" fill="currentColor" stroke="none" />
      ))
    }
  </g>

  <!-- Gitara wychodząca poza prawą krawędź: rysunek ma wyglądać na kadr, a nie na
       naklejkę na środku pola. Środek układu to oś instrumentu. -->
  <g transform="translate(146 56) rotate(12) scale(0.48)" stroke-width="1.25">
    <!-- Pudło: górna esica, talia, dolna esica. -->
    <path
      d="M0 82C22 82 38 96 38 113C38 128 33 138 33 152C33 166 49 168 49 182C49 202 33 216 0 216C-33 216 -49 202 -49 182C-49 168 -33 166 -33 152C-33 138 -38 128 -38 113C-38 96 -22 82 0 82Z"
    />

    <!-- Otwór rezonansowy z rozetą. -->
    <circle cx="0" cy="119.5" r="11.8" />
    <circle cx="0" cy="119.5" r="14.5" stroke-width="0.7" />

    <!-- Mostek z siodełkiem. -->
    <rect x="-13" y="174" width="26" height="7" rx="1.5" />
    <line x1="-11" y1="176.5" x2="11" y2="176.5" stroke-width="0.7" />

    <!-- Gryf zwężający się ku siodełku. -->
    <path d="M-7.1 0L7.1 0L8.5 82L-8.5 82Z" />

    <!-- Siodełko: grubsza kreska, bo to ono wyznacza początek menzury. -->
    <line x1="-7.6" y1="0" x2="7.6" y2="0" stroke-width="2.4" />

    <!-- Główka ze szparami i sześcioma kluczami, po trzy na stronę. -->
    <path d="M-8 0L-10.5 -28A3 3 0 0 1 -7.5 -33L7.5 -33A3 3 0 0 1 10.5 -28L8 0Z" />
    {
      [-6, 2].map((x) => (
        <rect x={x} y="-30" width="4" height="24" rx="2" stroke-width="0.7" />
      ))
    }
    {
      [-10, -18, -26].flatMap((y) =>
        [-12.5, 12.5].map((x) => <circle cx={x} cy={y} r="1.8" stroke-width="0.7" />),
      )
    }

    {/* Progi: od siodełka do styku z pudłem, z malejącym rozstawem. */}
    {
      frets.map((y) => (
        <line x1={-neckHalfWidth(y)} y1={y} x2={neckHalfWidth(y)} y2={y} />
      ))
    }

    {/* Struny biegną od siodełka nad otworem rezonansowym aż do mostka. */}
    {
      strings.map(({ xNut, xBridge }) => (
        <line x1={xNut} y1="0" x2={xBridge} y2={SCALE_LENGTH - 2} stroke-width="0.85" />
      ))
    }
  </g>

  <!-- Pięciolinia z nutami, wzdłuż lewej krawędzi. -->
  <g transform="translate(-14 126) rotate(-8)">
    {[0, 3, 6, 9, 12].map((y) => <line x1="0" y1={y} x2="58" y2={y} />)}
    <g transform="translate(20 6)">
      <ellipse cx="0" cy="3" rx="4" ry="3" transform="rotate(-20)" fill="currentColor" stroke="none" />
      <line x1="3.7" y1="1.8" x2="3.7" y2="-11" />
      <ellipse cx="14" cy="0" rx="4" ry="3" transform="rotate(-20 14 0)" fill="currentColor" stroke="none" />
      <line x1="17.7" y1="-1.2" x2="17.7" y2="-13" />
      <path d="M3.7 -11L17.7 -13" stroke-width="2" />
    </g>
  </g>

  <!-- Pojedyncza ósemka w wolnym polu obok pięciolinii. -->
  <g transform="translate(72 131) rotate(-12) scale(0.9)" stroke-width="0.67">
    <ellipse cx="0" cy="0" rx="4" ry="3" transform="rotate(-20)" fill="currentColor" stroke="none" />
    <line x1="3.7" y1="-1.2" x2="3.7" y2="-14" />
    <path d="M3.7 -14C7.5 -12 9 -9 8 -6" />
  </g>
</svg>
