---
import BaseLayout from "../layouts/base-layout.astro";
import SiteHeader from "../components/site-header.astro";
import Hero from "../components/hero.astro";
import Objections from "../components/objections.astro";
import Instruments from "../components/instruments.astro";
import About from "../components/about.astro";
import HowItWorks from "../components/how-it-works.astro";
import AppTeaser from "../components/app-teaser.astro";
import Testimonials from "../components/testimonials.astro";
import PricingTeaser from "../components/pricing-teaser.astro";
import Faq from "../components/faq.astro";
import ContactCta from "../components/contact-cta.astro";
import SiteFooter from "../components/site-footer.astro";
---

<BaseLayout>
  <SiteHeader />
  <main id="tresc">
    <Hero />
    <Objections />
    <Instruments />
    <About />
    <HowItWorks />
    <AppTeaser />
    <Testimonials />
