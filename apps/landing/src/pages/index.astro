---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import Hero from "../components/Hero.astro";
import Objections from "../components/Objections.astro";
import Instruments from "../components/Instruments.astro";
import About from "../components/About.astro";
import HowItWorks from "../components/HowItWorks.astro";
import AppTeaser from "../components/AppTeaser.astro";
import Testimonials from "../components/Testimonials.astro";
import PricingTeaser from "../components/PricingTeaser.astro";
import Faq from "../components/Faq.astro";
import ContactCta from "../components/ContactCta.astro";
import SiteFooter from "../components/SiteFooter.astro";
---

<BaseLayout>
  <SiteHeader />
  <main id="tresc">
    <Hero />
    <Objections />
    <Instruments />
    <About />
