---
import BaseLayout from "../layouts/BaseLayout.astro";

const appUrl = import.meta.env.PUBLIC_APP_URL ?? "http://127.0.0.1:5173";
---

<BaseLayout>
  <main>
    <nav class="nav container" aria-label="Main navigation">
      <a class="brand" href="/">nutka<span>•</span></a>
      <a class="text-link" href="#lessons">How it works</a>
      <a class="button small" href={appUrl}>Student sign in</a>
    </nav>

    <section class="hero container">
      <div>
        <p class="eyebrow">ONLINE MUSIC LESSONS</p>
        <h1>Make more room for music in your life.</h1>
        <p class="lede">Friendly, focused lessons that meet you where you are—and help you play with confidence.</p>
        <div class="actions">
          <a class="button" href={appUrl}>Start learning</a>
          <a class="text-link" href="#lessons">Explore lessons <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <aside class="hero-card" aria-label="A joyful piano lesson">
        <div class="note note-one">♪</div>
        <div class="note note-two">♫</div>
        <p>One clear note<br />at a time.</p>
      </aside>
    </section>

    <section class="section tinted">
      <div class="container split">
        <p class="eyebrow">LEARNING THAT LISTENS</p>
        <div>
          <h2>For every first chord, brave try, and encore.</h2>
          <p>Nutka makes music lessons feel personal. Build your technique, musical ear, and a practice habit that fits real life.</p>
        </div>
      </div>
    </section>

    <section id="lessons" class="section container">
      <p class="eyebrow">CHOOSE YOUR RHYTHM</p>
      <h2>Lessons shaped around your goals.</h2>
      <div class="cards">
        <article><span>01</span><h3>Private lessons</h3><p>One-to-one guidance for piano, voice, guitar, and more.</p></article>
        <article><span>02</span><h3>Young musicians</h3><p>Playful foundations for curious kids and their growing ears.</p></article>
        <article><span>03</span><h3>Practice support</h3><p>Small, achievable next steps between every lesson.</p></article>
      </div>
    </section>

    <section class="section instructor">
      <div class="container instructor-grid">
        <div class="portrait" aria-hidden="true">♬</div>
        <div>
          <p class="eyebrow">YOUR GUIDE</p>
          <h2>“The best lesson is the one that makes you want to come back tomorrow.”</h2>
          <p>Our teachers bring deep musical experience and a gentle, encouraging way of helping students find their own voice.</p>
        </div>
      </div>
    </section>

    <section class="section container testimonial">
      <blockquote>“I stopped thinking of myself as someone who used to play. Now I play every day.”</blockquote>
      <p>— Maya, adult piano student</p>
    </section>

    <section class="cta container">
      <p class="eyebrow">YOUR NEXT NOTE</p>
      <h2>Let’s make music together.</h2>
      <a class="button" href={appUrl}>Enter the learner app</a>
    </section>
  </main>
</BaseLayout>

<style>
  .container { width: min(1120px, calc(100% - 3rem)); margin: 0 auto; }
  .nav { display: flex; align-items: center; justify-content: space-between; padding: 1.5rem 0; }
  .brand { font-size: 1.5rem; font-weight: 800; text-decoration: none; letter-spacing: -.06em; }
  .brand span { color: #e76f51; }
  .button { display: inline-block; padding: .85rem 1.2rem; border-radius: 999px; background: #17231f; color: #fff; font-weight: 700; text-decoration: none; }
  .button:hover { background: #365246; }
  .button.small { padding: .6rem 1rem; font-size: .9rem; }
  .text-link { font-weight: 700; text-underline-offset: .25rem; }
  .hero { display: grid; grid-template-columns: 1.3fr .7fr; gap: 4rem; align-items: center; min-height: 70vh; padding: 4rem 0 6rem; }
  .eyebrow { color: #e76f51; font-size: .75rem; font-weight: 800; letter-spacing: .13em; }
  h1, h2, h3, p { margin-top: 0; }
  h1, h2 { letter-spacing: -.055em; line-height: .98; }
  h1 { max-width: 750px; font-size: clamp(3.6rem, 9vw, 7rem); margin-bottom: 1.4rem; }
  h2 { font-size: clamp(2.3rem, 5vw, 4rem); margin-bottom: 1.25rem; }
  .lede { max-width: 540px; color: #53645c; font-size: 1.15rem; line-height: 1.65; }
  .actions { display: flex; align-items: center; gap: 1.5rem; margin-top: 2rem; }
  .hero-card { position: relative; min-height: 350px; padding: 2rem; overflow: hidden; border-radius: 1.5rem; background: #f0ba58; color: #243e36; }
  .hero-card p { position: absolute; right: 1.8rem; bottom: 1.6rem; margin: 0; font-family: Georgia, serif; font-size: 2rem; font-style: italic; line-height: 1.05; text-align: right; }
  .note { position: absolute; font-size: 8rem; font-family: Georgia, serif; line-height: 1; }
  .note-one { top: 2.5rem; left: 2rem; transform: rotate(-20deg); }
  .note-two { top: 7rem; right: 2rem; transform: rotate(15deg); }
  .section { padding: 6rem 0; }
  .tinted { background: #d9e4d6; }
  .split, .instructor-grid { display: grid; grid-template-columns: .75fr 1.25fr; gap: 3rem; }
  .split p:not(.eyebrow), .instructor p:not(.eyebrow) { max-width: 620px; color: #53645c; font-size: 1.1rem; line-height: 1.65; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-top: 2.5rem; }
  .cards article { padding: 1.8rem; border: 1px solid #d7d4ca; border-radius: 1rem; background: #fffdf7; }
  .cards span { color: #e76f51; font-weight: 800; }
  .cards h3 { margin: 2rem 0 .75rem; font-size: 1.35rem; }
  .cards p { color: #53645c; line-height: 1.55; }
  .instructor { background: #243e36; color: #fffdf7; }
  .instructor p { color: #cbd8ce !important; }
  .portrait { display: grid; min-height: 300px; place-items: center; border-radius: 50%; background: #e76f51; color: #f0ba58; font-family: Georgia, serif; font-size: 10rem; }
  .testimonial { max-width: 800px; padding: 7rem 0; text-align: center; }
  blockquote { margin: 0 0 1.5rem; font-family: Georgia, serif; font-size: clamp(2rem, 5vw, 3.7rem); font-style: italic; letter-spacing: -.04em; line-height: 1.05; }
  .testimonial p { color: #53645c; }
  .cta { margin-bottom: 3rem; padding: 4rem; border-radius: 1.5rem; background: #f0ba58; text-align: center; }
  .cta h2 { margin-bottom: 2rem; }
  @media (max-width: 720px) {
    .hero, .split, .instructor-grid { grid-template-columns: 1fr; gap: 2rem; }
    .hero { padding-top: 2rem; }
    .hero-card { min-height: 260px; }
    .cards { grid-template-columns: 1fr; }
    .nav .text-link { display: none; }
    .section { padding: 4rem 0; }
    .cta { padding: 3rem 1.5rem; }
  }
</style>
